#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["fonttools>=4.60,<5"]
# ///
"""Export PNG social avatars from the optically centered favicon geometry."""
import argparse, copy, subprocess, xml.etree.ElementTree as ET
from pathlib import Path
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('output',type=Path,nargs='?',default=Path.home()/'Downloads'/'Plenty-social-assets')
a=p.parse_args(); a.output.mkdir(parents=True,exist_ok=True)
root=Path(__file__).resolve().parents[1]
ns='http://www.w3.org/2000/svg'; ET.register_namespace('',ns)
original=ET.parse(root/'assets/images/favicon.svg').getroot()
colors={'light':{'b':'#f4f0e6','l':'#17150f','d':'#c7361c'},'dark':{'b':'#121110','l':'#f2ede2','d':'#ff6a48'}}
for theme,palette in colors.items():
 for shape in ['square','circle','transparent']:
  svg=copy.deepcopy(original)
  for node in list(svg):
   if node.tag.endswith('style'):svg.remove(node);continue
   cls=node.get('class')
   if cls=='b':
    svg.remove(node)
    if shape=='transparent':continue
    if shape=='circle':bg=ET.Element('{'+ns+'}circle',{'cx':'633.5','cy':'-211.5','r':'762.5','fill':palette['b']})
    else:bg=ET.Element('{'+ns+'}rect',{'x':'-129','y':'-974','width':'1525','height':'1525','fill':palette['b']})
    svg.insert(0,bg)
   elif cls:
    node.set('fill',palette[cls]);node.attrib.pop('class',None)
  src=a.output/f'plenty-{theme}-{shape}.svg';ET.ElementTree(svg).write(src,encoding='unicode')
  for size in [1024,2048]:
   subprocess.run(['rsvg-convert','-w',str(size),'-h',str(size),'-o',str(a.output/f'plenty-{theme}-{shape}-{size}.png'),str(src)],check=True)
# A company banner uses the existing outlined wordmark, not retyped lettering.
wordmark=ET.parse(root/'assets/images/plenty-wordmark.svg').getroot()
for n in list(wordmark):
 if n.tag.endswith('style'):wordmark.remove(n)
 elif n.get('class'):n.set('fill',colors['light'][n.get('class')]);n.attrib.pop('class',None)
wordmark.set('x','65');wordmark.set('y','45');wordmark.set('width','380');wordmark.set('height','100')
svg=ET.Element('{'+ns+'}svg',{'viewBox':'0 0 1128 191'})
ET.SubElement(svg,'{'+ns+'}rect',{'width':'1128','height':'191','fill':'#f4f0e6'})
svg.append(wordmark)
# Outline the site's actual typefaces so no machine can silently substitute a font.
from fontTools.ttLib import TTFont
from fontTools.pens.svgPathPen import SVGPathPen
for y,text,size,fontname in [(84,'Good enough isn’t Plenty.',24,'Unbounded-SemiBold.ttf'),(125,'Software by Carmine Paolino.',23,'Geist-Regular.ttf')]:
 font=TTFont(root/'assets/fonts'/fontname);glyphs=font.getGlyphSet();cmap=font.getBestCmap()
 scale=size/font['head'].unitsPerEm;cursor=0
 group=ET.SubElement(svg,'{'+ns+'}g',{'transform':f'translate(535 {y}) scale({scale} {-scale})','fill':'#17150f','aria-label':text})
 for char in text:
  name=cmap[ord(char)];pen=SVGPathPen(glyphs);glyphs[name].draw(pen)
  if pen.getCommands():ET.SubElement(group,'{'+ns+'}path',{'d':pen.getCommands(),'transform':f'translate({cursor} 0)'})
  cursor+=glyphs[name].width
 assert cursor*scale<540, 'Banner text exceeds its safe width'
src=a.output/'plenty-linkedin-company-banner.svg';ET.ElementTree(svg).write(src,encoding='unicode')
subprocess.run(['rsvg-convert','-w','2256','-h','382','-o',str(a.output/'plenty-linkedin-company-banner.png'),str(src)],check=True)
# Social preview card, using the same outlined typography as the banner.
og=ET.Element('{'+ns+'}svg',{'viewBox':'0 0 1200 630'})
ET.SubElement(og,'{'+ns+'}rect',{'width':'1200','height':'630','fill':'#f4f0e6'})
for row in range(5):
 for col in range(5):
  ET.SubElement(og,'{'+ns+'}circle',{'cx':str(965+col*36),'cy':str(91+row*36),'r':'11','fill':'#c7361c' if (row,col)==(2,3) else '#d9d2c1'})
mark=copy.deepcopy(wordmark)
mark.set('x','75');mark.set('y','260');mark.set('width','640');mark.set('height','175');og.append(mark)
for index,group in enumerate(svg.findall('{'+ns+'}g')):
 line=copy.deepcopy(group)
 fontname='Unbounded-SemiBold.ttf' if index==0 else 'Geist-Regular.ttf'
 scale=(32 if index==0 else 28)/TTFont(root/'assets/fonts'/fontname)['head'].unitsPerEm
 line.set('transform',f'translate(82 {490+index*53}) scale({scale} {-scale})')
 og.append(line)
ogsrc=a.output/'plenty-og.svg';ET.ElementTree(og).write(ogsrc,encoding='unicode')
subprocess.run(['rsvg-convert','-w','1200','-h','630','-o',str(a.output/'plenty-og.png'),str(ogsrc)],check=True)
(a.output/'README.txt').write_text('Plenty social assets\n\nAvatar geometry: assets/images/favicon.svg, optically centered in commit 74b3248. Path positions and viewBox are preserved.\n\nUse plenty-light-square-1024.png for LinkedIn and other services that apply their own circle or rounded crop.\nSquare: full background. Circle: circular background with transparent corners. Transparent: mark only.\nLight and dark palettes are taken directly from the favicon. Every avatar is available at 1024 and 2048 pixels. PNGs are rendered directly from vectors, not enlarged from the old 512px logo.\n\nRegenerate: bin/export-social-logos [output-directory]\n')
print(a.output)
